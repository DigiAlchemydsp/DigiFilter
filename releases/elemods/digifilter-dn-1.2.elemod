{
 "elemod": 2,
 "id": "digifilter-dn",
 "version": "1.2",
 "title": "Filter+FX-DN",
 "description": "Filter+FX for the Digitone mk1/Keys (OS 1.44): VOWEL, BANK, FOLD, CRUSH, RING, PHASER and FLANGER as TYPE 4..10 on top of stock OFF/LP2/HP/LP4, using each voice's own FREQ/RESO and filter envelope. VOWEL/BANK add two controls on page-2 free C/G (params 182/183). Runs the DSP at the per-voice filter call; draws the FLTR graph and TYPE-box icons from ev_draw. Stock TYPE 0..3 still runs the stock multimode filter. Port of DigiFilter/Filter+FX (Digitakt).",
 "category": "Sound",
 "author": "Digital Alchemy DSP",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.44",
