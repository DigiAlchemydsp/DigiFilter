{
 "elemod": 2,
 "id": "digifilter-dn",
 "version": "1.3",
 "title": "DigiFilter-DN",
 "description": "Per-voice filter modes for the Digitone mk1/Keys (OS 1.44): BP, BP2, COMB, TRASH, OB4 and OB2 as TYPE 4..9 on top of stock OFF/LP2/HP/LP4, using each voice's own FREQ/RESO and filter envelope. Widens the TYPE range to 9 and the value-text list to 10 with names and TYPE-box icons, runs the shared DigiFilter DSP at the per-voice filter call, and adds HARM/DAMP on page-2 free C/G for COMB/TRASH (params 182/183). The FLTR page draws the FREQ/RESO response curve and the 17x17 TYPE-box icon. Stock TYPE 0..3 still runs the stock multimode filter. Same modes as DigiFilter for the Digitakt; OB-1 by Simon Johansson.",
 "category": "Sound",
 "author": "Digital Alchemy DSP",
 "license": "GPL-2.0-or-later",
 "target": {
  "device": "digitone-mk1",
  "product": "Digitone mk1",
  "os": "1.44",
  "syx_sha256": "d4f200d04484333d82822db7744e6484d0def8f2db8ddf55ee2b780cc13c9659",
  "section3_sha256": "fce648a97c6c5d93b961732e8f8db6b02e0820c6d344c7e2131fa05a4b3168e4",
  "section3_len": 2736304
 },
